# synapsed.env — EnvironmentFile for synapsed.service (THUGS(red) SynapseIDS)
#
# Install:  install -m 0640 -o root -g synapse contrib/systemd/synapsed.env /etc/synapseids/synapsed.env
# Loaded by the unit via `EnvironmentFile=-/etc/synapseids/synapsed.env` (the '-'
# means "optional"; the daemon starts fine without this file).
#
# systemd EnvironmentFile syntax: one KEY=VALUE per line, no `export`, no shell
# expansion, no inline comments after a value. Everything is commented out below;
# uncomment only what you need to override.
#
# PROJECT.md §23: prefer one config file plus environment overrides for
# deployment/secret concerns. These SYNAPSE_* variables ALWAYS win over the
# matching key in /etc/synapseids/synapse.json, so they are the right place for
# host-specific paths and anything you do not want committed to the JSON file.

# Host:port for the REST + WebSocket listener. Overrides server.listen.
# Keep it on loopback and terminate TLS + auth in nginx (contrib/nginx/).
#SYNAPSE_LISTEN=127.0.0.1:8080

# Directory of static web UI assets served at "/". Empty / unset = built-in page.
#SYNAPSE_WEB_ROOT=/usr/share/synapseids/web

# Persistence backend. Only "memory" is accepted in this build; "sqlite" is
# parsed but rejected at startup (tracked).
#SYNAPSE_STORAGE_DRIVER=memory

# On-disk path for file-backed drivers. Ignored by the "memory" driver; set it
# now so a future sqlite backend lands inside StateDirectory.
#SYNAPSE_STORAGE_PATH=/var/lib/synapseids/synapse.db

# Directory scanned for model bundles. Overrides models.directory (Phase 2).
#SYNAPSE_MODELS_DIR=/var/lib/synapseids/models

# Upper bound on the live flow table. Overrides capture.max_flows. Must be > 0
# or the override is ignored.
#SYNAPSE_MAX_FLOWS=200000
