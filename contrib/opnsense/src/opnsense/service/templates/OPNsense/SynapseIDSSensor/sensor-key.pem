{#-
 # sensor-key.pem - configd (Jinja2) template for
 #                  /usr/local/etc/synapseids/sensor-key.pem
 #
 # Copyright (C) 2026 SynapseIDS contributors
 # BSD 2-Clause; see Sensor.php for the full text.
 #
 # THE SENSOR'S TLS PRIVATE KEY, AND NOTHING ELSE.
 #
 # This is the second secret on the box, after sensor.token, and it gets exactly
 # the same treatment (PROJECT.md section 21, section 23):
 #
 #   * 0400 _synapseids:_synapseids - readable by the service user and nobody
 #     else, not even group wheel;
 #   * clamped by `configctl synapseidssensor fixperms` IMMEDIATELY after every
 #     `template reload`, because configd renders templates as root under its own
 #     umask and would otherwise leave a fresh private key mode 0644 for as long
 #     as it took somebody to notice.  Api\SettingsController::applyConfiguration
 #     and Api\ServiceController::reconfigureAction both run fixperms straight
 #     after the reload for that reason;
 #   * re-checked by the rc.d start_precmd before every start, so a key that got
 #     loosened by hand is tightened again (and a key owned by the wrong user is
 #     a hard start failure, not a downgrade);
 #   * never rendered into sensor.conf, never passed on a command line, never
 #     logged.  Only the PATH reaches argv, as --key.
 #
 # An empty key field renders an empty file rather than no file.  sensor.conf
 # only emits --cert/--key when BOTH the certificate and the key are set, and the
 # rc.d script refuses to start when a referenced PEM is missing or empty, so an
 # empty render can never become a silent fallback to an unauthenticated or
 # unverified transport - it is a loud refusal naming the path.
 #
 # Encrypted keys are rejected at save time by Sensor::performValidation: Go's
 # crypto/tls cannot use a passphrase-protected key and there is nowhere on an
 # unattended firewall to type one, so it would be a start-time surprise.
-#}
{%- if helpers.exists('OPNsense.SynapseIDSSensor.general.client_key') -%}
{{ OPNsense.SynapseIDSSensor.general.client_key | string | replace('\r\n', '\n') | replace('\r', '\n') | trim }}
{% endif %}
