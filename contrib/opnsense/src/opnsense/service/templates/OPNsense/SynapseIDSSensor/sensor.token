{#-
 # sensor.token - configd (Jinja2) template for
 #                /usr/local/etc/synapseids/sensor.token
 #
 # Copyright (C) 2026 SynapseIDS contributors
 # BSD 2-Clause; see Sensor.php for the full text.
 #
 # This file contains the bearer token and NOTHING else - no comment header, no
 # shell syntax - because synapse-sensor reads the whole file and trims
 # surrounding whitespace (see cmd/synapse-sensor/pcapoverip.go: --token-file).
 #
 # It is the only place on the firewall, besides config.xml, where the token
 # exists.  configd renders it as root:wheel with the default umask, so
 # `configctl synapseidssensor fixperms` immediately chowns it to
 # _synapseids:_synapseids and chmods it to 0400; the rc.d start_precmd checks
 # again before starting the sensor.
 #
 # An empty token renders an empty file, which synapse-sensor treats as "no
 # token" - it then accepts any peer that completes the TLS handshake and logs
 # a warning.  Sensor::performValidation refuses to enable the sensor in that
 # state.
-#}
{%- if helpers.exists('OPNsense.SynapseIDSSensor.general.token') -%}
{{ OPNsense.SynapseIDSSensor.general.token | string | trim }}
{%- endif -%}
