{#-
 # sensor-ca.pem - configd (Jinja2) template for
 #                 /usr/local/etc/synapseids/sensor-ca.pem
 #
 # Copyright (C) 2026 SynapseIDS contributors
 # BSD 2-Clause; see Sensor.php for the full text.
 #
 # The peer trust bundle, and NOTHING else - no comment header, no shell syntax
 # - because Go's crypto/x509 CertPool.AppendCertsFromPEM scans for PEM blocks
 # and a stray line is at best ignored and at worst confusing in a diff.
 #
 #   connect mode: rendered as --ca        (verify the collector we dial)
 #   listen  mode: rendered as --client-ca (require and verify a client cert)
 #
 # This is PUBLIC trust material, so it is 0444 root:wheel - the same posture as
 # any CA bundle in /etc/ssl.  It still goes through `configctl synapseidssensor
 # fixperms` immediately after every `template reload`, because configd writes
 # rendered templates with its own umask and the plugin fixes ALL of its files in
 # one place rather than reasoning about which ones happen not to matter.
 #
 # An empty CA field renders an empty file.  That is safe: sensor.conf only emits
 # the --ca / --client-ca flag when the field is non-empty, and the rc.d script
 # refuses to start when a flag names a PEM that is missing or does not contain a
 # BEGIN line.  A missing CA can therefore never silently downgrade the transport
 # to an unverified connection.
 #
 # CRLF is normalised away: an operator pasting from a Windows editor would
 # otherwise store \r\n, and while Go tolerates that in PEM, the file should
 # match what `openssl x509 -in` on the box expects.
-#}
{%- if helpers.exists('OPNsense.SynapseIDSSensor.general.ca') -%}
{{ OPNsense.SynapseIDSSensor.general.ca | string | replace('\r\n', '\n') | replace('\r', '\n') | trim }}
{% endif %}
