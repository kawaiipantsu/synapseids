{#-
 # sensor-cert.pem - configd (Jinja2) template for
 #                   /usr/local/etc/synapseids/sensor-cert.pem
 #
 # Copyright (C) 2026 SynapseIDS contributors
 # BSD 2-Clause; see Sensor.php for the full text.
 #
 # This sensor's own certificate, rendered as --cert:
 #
 #   listen  mode: the TLS server identity the daemon verifies
 #   connect mode: the mutual-TLS client identity the collector verifies
 #
 # A certificate is public, so 0444 root:wheel.  Its private key is a different
 # matter entirely - see sensor-key.pem.
 #
 # Rendered together with sensor-key.pem or not at all: Sensor::performValidation
 # refuses to save half a pair, sensor.conf only emits --cert/--key when both
 # fields are set, and `synapse-sensor doctor` re-checks that the two halves
 # actually match (a mismatched copy-paste into two textareas is the mistake this
 # catches).
-#}
{%- if helpers.exists('OPNsense.SynapseIDSSensor.general.client_cert') -%}
{{ OPNsense.SynapseIDSSensor.general.client_cert | string | replace('\r\n', '\n') | replace('\r', '\n') | trim }}
{% endif %}
