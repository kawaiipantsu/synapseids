{
  "server": {
    "listen": "127.0.0.1:8080",
    "web_root": ""
  },
  "storage": {
    "driver": "memory",
    "path": "/var/lib/synapseids/synapse.db",
    "max_flows": 50000
  },
  "capture": {
    "flow_idle_timeout": "30s",
    "flow_max_lifetime": "5m",
    "snapshot_interval": "60s",
    "max_flows": 200000,
    "sources": []
  },
  "models": {
    "directory": "/var/lib/synapseids/models",
    "primary": ""
  },
  "alerts": {
    "enabled": true,
    "min_confidence": 0.7,
    "per_class_min_confidence": {
      "suspicious": 0.85
    },
    "alert_on_disagreement": true,
    "max_recent": 1000,
    "dedup_window_sec": 60
  },
  "live": {
    "websocket_batch": "100ms",
    "client_queue_size": 5000
  },
  "retention": {
    "flows": "720h",
    "classifications": "2160h"
  }
}
