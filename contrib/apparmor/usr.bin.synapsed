# AppArmor profile for synapsed — THUGS(red) SynapseIDS
#
# Install:
#   install -m 0644 contrib/apparmor/usr.bin.synapsed /etc/apparmor.d/usr.bin.synapsed
#   apparmor_parser -r -W /etc/apparmor.d/usr.bin.synapsed
#
# Start in learning mode, then enforce once the logs are quiet:
#   aa-complain /usr/bin/synapsed
#   journalctl -k | grep -i 'apparmor.*profile="synapsed"'   # watch for DENIED
#   aa-enforce  /usr/bin/synapsed
#
# AppArmor is deny-by-default once a profile is attached: anything not granted
# below is already blocked. The explicit `deny` rules near the end only exist to
# silence predictable log noise and document intent — they do NOT overlap any
# allow rule (an AppArmor deny always wins, regardless of order).
#
# This profile assumes the packaged layout. Adjust EVERY path to your install,
# especially the PCAP input directories.

abi <abi/3.0>,

include <tunables/global>

profile synapsed /usr/bin/synapsed flags=(attach_disconnected) {
  include <abstractions/base>
  include <abstractions/nameservice>
  include <abstractions/ssl_certs>

  # --- capabilities: future live capture only -----------------------------
  # Phase 1 (PCAP replay) needs neither; comment both out for a replay-only host.
  capability net_raw,
  capability net_admin,

  # --- network -------------------------------------------------------------
  network inet  stream,
  network inet6 stream,
  network inet  dgram,
  network inet6 dgram,
  network netlink raw,          # interface enumeration, CAP_NET_ADMIN ops
  network packet raw,           # AF_PACKET live capture (future)
  unix (bind, listen, accept, connect, send, receive) type=stream,

  # --- the binary --------------------------------------------------------
  /usr/bin/synapsed            mr,

  # --- configuration: read only --------------------------------------
  /etc/synapseids/             r,
  /etc/synapseids/**           r,

  # --- state: recent-flow rings snapshot, model bundles, future db --
  /var/lib/synapseids/         rw,
  /var/lib/synapseids/**       rwk,

  # --- PCAP inputs for replay: ADJUST TO YOUR CAPTURE DIRS ----------
  /var/lib/synapseids/pcaps/**   r,
  /srv/pcap/**                   r,
  # owner /home/*/captures/**    r,

  # --- logs, only if redirected to files ---------------------------
  /var/log/synapseids/          rw,
  /var/log/synapseids/**        rwk,

  # --- Go runtime / libc bits not already in abstractions/base ---
  @{PROC}/sys/net/core/somaxconn                       r,
  owner @{PROC}/@{pid}/{stat,status,cgroup,cmdline,maps,limits}  r,
  owner @{PROC}/@{pid}/net/**                          r,
  /sys/kernel/mm/transparent_hugepage/hpage_pmd_size   r,
  /sys/devices/system/cpu/                             r,
  /sys/devices/system/cpu/**                           r,

  # PrivateTmp= in the systemd unit already isolates this; allowed here for
  # operators who run the binary without the unit.
  owner /tmp/**   rw,

  # --- explicit denials (documentation + quieter logs) ------------
  deny /etc/**   w,
  deny /usr/**   w,
  deny /bin/**   w,
  deny /sbin/**  w,
  deny /boot/**  rwx,
  deny /root/**  rwx,
  deny owner /home/** rw,
  # (No blanket `deny /var/**` or `deny /var/log/**` — an AppArmor deny always
  #  wins over an allow, so it would break the /var/lib/synapseids and
  #  /var/log/synapseids grants above. Default-deny already covers the rest.)

  # Never read the shadow database or ssh private keys.
  deny /etc/shadow  r,
  deny /etc/gshadow r,
  deny /etc/ssh/**  r,
}
