{
  "schema": "flow-features-v1",
  "version": 1,
  "frozen": true,
  "description": "Per-flow numeric feature vector for the flow-classifier-v1 model family. Computed entirely from a single bidirectional flow record; no raw IP addresses, no cross-flow host state (that is reserved for a future flow-features-v2). Once released, the order and meaning of these entries never change (PROJECT.md §8, §28.5).",
  "input_size": 48,
  "default_missing": 0.0,
  "features": [
    { "index": 0,  "name": "flow_duration",              "type": "float", "unit": "seconds", "calc": "last_seen - first_seen",                                  "missing": "0 for a flow with a single packet", "norm": "log1p" },
    { "index": 1,  "name": "packets_forward",            "type": "float", "unit": "count",   "calc": "packet count initiator->responder",                       "missing": "0",                                  "norm": "log1p" },
    { "index": 2,  "name": "packets_backward",           "type": "float", "unit": "count",   "calc": "packet count responder->initiator",                       "missing": "0",                                  "norm": "log1p" },
    { "index": 3,  "name": "bytes_forward",              "type": "float", "unit": "bytes",   "calc": "sum of IP datagram lengths forward (IP header included)",   "missing": "0",                                  "norm": "log1p" },
    { "index": 4,  "name": "bytes_backward",             "type": "float", "unit": "bytes",   "calc": "sum of IP datagram lengths backward (IP header included)",  "missing": "0",                                  "norm": "log1p" },
    { "index": 5,  "name": "packet_size_mean",           "type": "float", "unit": "bytes",   "calc": "mean total packet size over the flow",                     "missing": "0",                                  "norm": "standard" },
    { "index": 6,  "name": "packet_size_min",            "type": "float", "unit": "bytes",   "calc": "min total packet size",                                    "missing": "0",                                  "norm": "standard" },
    { "index": 7,  "name": "packet_size_max",            "type": "float", "unit": "bytes",   "calc": "max total packet size",                                    "missing": "0",                                  "norm": "standard" },
    { "index": 8,  "name": "packet_size_stddev",         "type": "float", "unit": "bytes",   "calc": "population stddev of packet size",                          "missing": "0 for <2 packets",                   "norm": "standard" },
    { "index": 9,  "name": "forward_packet_size_mean",   "type": "float", "unit": "bytes",   "calc": "mean packet size forward",                                 "missing": "0",                                  "norm": "standard" },
    { "index": 10, "name": "backward_packet_size_mean",  "type": "float", "unit": "bytes",   "calc": "mean packet size backward",                                "missing": "0",                                  "norm": "standard" },
    { "index": 11, "name": "packets_per_second",         "type": "float", "unit": "1/s",     "calc": "total packets / max(flow_duration, 1e-6)",                 "missing": "total packets when duration is 0",   "norm": "log1p" },
    { "index": 12, "name": "bytes_per_second",           "type": "float", "unit": "bytes/s", "calc": "total bytes / max(flow_duration, 1e-6)",                   "missing": "total bytes when duration is 0",     "norm": "log1p" },
    { "index": 13, "name": "forward_packets_per_second", "type": "float", "unit": "1/s",     "calc": "packets_forward / max(flow_duration, 1e-6)",               "missing": "packets_forward when duration is 0", "norm": "log1p" },
    { "index": 14, "name": "backward_packets_per_second","type": "float", "unit": "1/s",     "calc": "packets_backward / max(flow_duration, 1e-6)",              "missing": "packets_backward when duration is 0","norm": "log1p" },
    { "index": 15, "name": "interarrival_mean",          "type": "float", "unit": "seconds", "calc": "mean inter-arrival gap over all packets",                  "missing": "0 for <2 packets",                   "norm": "log1p" },
    { "index": 16, "name": "interarrival_min",           "type": "float", "unit": "seconds", "calc": "min inter-arrival gap",                                    "missing": "0 for <2 packets",                   "norm": "log1p" },
    { "index": 17, "name": "interarrival_max",           "type": "float", "unit": "seconds", "calc": "max inter-arrival gap",                                    "missing": "0 for <2 packets",                   "norm": "log1p" },
    { "index": 18, "name": "interarrival_stddev",        "type": "float", "unit": "seconds", "calc": "population stddev of inter-arrival gaps",                   "missing": "0 for <3 packets",                   "norm": "log1p" },
    { "index": 19, "name": "forward_interarrival_mean",  "type": "float", "unit": "seconds", "calc": "mean forward inter-arrival gap",                           "missing": "0 for <2 forward packets",           "norm": "log1p" },
    { "index": 20, "name": "backward_interarrival_mean", "type": "float", "unit": "seconds", "calc": "mean backward inter-arrival gap",                          "missing": "0 for <2 backward packets",          "norm": "log1p" },
    { "index": 21, "name": "source_port",                "type": "float", "unit": "port",    "calc": "initiator L4 port (0 for ICMP)",                           "missing": "0",                                  "norm": "identity" },
    { "index": 22, "name": "destination_port",           "type": "float", "unit": "port",    "calc": "responder L4 port (0 for ICMP)",                           "missing": "0",                                  "norm": "identity" },
    { "index": 23, "name": "protocol_tcp",               "type": "bool",  "unit": "flag",    "calc": "1 if transport is TCP",                                    "missing": "0",                                  "norm": "identity" },
    { "index": 24, "name": "protocol_udp",               "type": "bool",  "unit": "flag",    "calc": "1 if transport is UDP",                                    "missing": "0",                                  "norm": "identity" },
    { "index": 25, "name": "protocol_icmp",              "type": "bool",  "unit": "flag",    "calc": "1 if transport is ICMPv4/ICMPv6",                          "missing": "0",                                  "norm": "identity" },
    { "index": 26, "name": "tcp_syn_count",              "type": "float", "unit": "count",   "calc": "packets with SYN set",                                     "missing": "0",                                  "norm": "log1p" },
    { "index": 27, "name": "tcp_ack_count",              "type": "float", "unit": "count",   "calc": "packets with ACK set",                                     "missing": "0",                                  "norm": "log1p" },
    { "index": 28, "name": "tcp_fin_count",              "type": "float", "unit": "count",   "calc": "packets with FIN set",                                     "missing": "0",                                  "norm": "log1p" },
    { "index": 29, "name": "tcp_rst_count",              "type": "float", "unit": "count",   "calc": "packets with RST set",                                     "missing": "0",                                  "norm": "log1p" },
    { "index": 30, "name": "tcp_psh_count",              "type": "float", "unit": "count",   "calc": "packets with PSH set",                                     "missing": "0",                                  "norm": "log1p" },
    { "index": 31, "name": "tcp_urg_count",              "type": "float", "unit": "count",   "calc": "packets with URG set",                                     "missing": "0",                                  "norm": "log1p" },
    { "index": 32, "name": "syn_ack_ratio",              "type": "float", "unit": "ratio",   "calc": "tcp_syn_count / max(tcp_ack_count, 1)",                    "missing": "tcp_syn_count when ack is 0",        "norm": "log1p" },
    { "index": 33, "name": "packet_direction_ratio",     "type": "float", "unit": "ratio",   "calc": "packets_forward / max(total packets, 1)",                  "missing": "0",                                  "norm": "identity" },
    { "index": 34, "name": "byte_direction_ratio",       "type": "float", "unit": "ratio",   "calc": "bytes_forward / max(total bytes, 1)",                      "missing": "0",                                  "norm": "identity" },
    { "index": 35, "name": "initial_tcp_window",         "type": "float", "unit": "bytes",   "calc": "TCP window of the first forward segment",                  "missing": "0 for non-TCP",                      "norm": "standard" },
    { "index": 36, "name": "average_tcp_window",         "type": "float", "unit": "bytes",   "calc": "mean advertised TCP window over the flow",                 "missing": "0 for non-TCP",                      "norm": "standard" },
    { "index": 37, "name": "down_up_bytes_ratio",        "type": "float", "unit": "ratio",   "calc": "bytes_backward / max(bytes_forward, 1)",                   "missing": "0",                                  "norm": "log1p" },
    { "index": 38, "name": "small_packet_ratio",         "type": "float", "unit": "ratio",   "calc": "fraction of packets <= 100 bytes total",                   "missing": "0",                                  "norm": "identity" },
    { "index": 39, "name": "large_packet_ratio",         "type": "float", "unit": "ratio",   "calc": "fraction of packets >= 1000 bytes total",                  "missing": "0",                                  "norm": "identity" },
    { "index": 40, "name": "average_payload_length",     "type": "float", "unit": "bytes",   "calc": "mean L4 payload length over all packets",                  "missing": "0",                                  "norm": "standard" },
    { "index": 41, "name": "bidirectional_flag",         "type": "bool",  "unit": "flag",    "calc": "1 if both directions carried >=1 packet",                  "missing": "0",                                  "norm": "identity" },
    { "index": 42, "name": "internal_to_internal",       "type": "bool",  "unit": "flag",    "calc": "1 if both endpoints are RFC1918 / ULA / link-local",       "missing": "0",                                  "norm": "identity" },
    { "index": 43, "name": "internal_to_external",       "type": "bool",  "unit": "flag",    "calc": "1 if initiator internal, responder external",              "missing": "0",                                  "norm": "identity" },
    { "index": 44, "name": "external_to_internal",       "type": "bool",  "unit": "flag",    "calc": "1 if initiator external, responder internal",              "missing": "0",                                  "norm": "identity" },
    { "index": 45, "name": "external_to_external",       "type": "bool",  "unit": "flag",    "calc": "1 if neither endpoint is internal",                        "missing": "0",                                  "norm": "identity" },
    { "index": 46, "name": "dest_port_is_wellknown",     "type": "bool",  "unit": "flag",    "calc": "1 if destination_port in [1, 1023]",                       "missing": "0",                                  "norm": "identity" },
    { "index": 47, "name": "snapshot_index",             "type": "float", "unit": "count",   "calc": "nth periodic snapshot of a long-lived flow; 0 on close",   "missing": "0",                                  "norm": "identity" }
  ]
}
